# Copy this file to .env and fill it in. Never commit .env.

# Postiz public API (only needed for posting).
#   Docker image (default ports):   http://localhost:5000/api/public/v1
#   Local dev (pnpm dev), backend:  http://localhost:3000/public/v1
POSTIZ_API_URL=http://localhost:5000/api/public/v1
# Postiz -> Settings -> Public API -> copy key
POSTIZ_API_KEY=

# Optional default channels (ids or names from `python pipeline.py channels`)
POSTIZ_INTEGRATIONS=

# Optional: AI-written hooks, titles, captions and hashtags (console.anthropic.com).
# Without it the pipeline uses built-in templates.
ANTHROPIC_API_KEY=

# Optional: only for --layout speaker (face-tracking crop). Needs access to
# pyannote/speaker-diarization-3.1 on Hugging Face.
HUGGINGFACE_TOKEN=
